# Copy to `.env.local` and fill in. Never commit `.env.local`.
# Server-side (API routes): see each route for GEMINI_*, DOUBAO_*, GROK_*, etc.

# --- 服务端访问境外 LLM（可选）：/api/* 使用 undici，默认连接超时 60s ---
# 仅代理 LLM 出站时填（勿与需直连国内的接口混用时乱配全局 HTTP_PROXY）：
# LLM_HTTP_PROXY=http://127.0.0.1:7897
# LLM_FETCH_CONNECT_TIMEOUT_MS=60000
# 慢速生图：响应头/体等待（默认约 8min / 15min）
# LLM_FETCH_HEADERS_TIMEOUT_MS=480000
# LLM_FETCH_BODY_TIMEOUT_MS=900000

# --- 豆包语音：大模型录音文件极速版（/api/asr 默认）---
# 文档: https://www.volcengine.com/docs/6561/1631584?lang=zh
# 新版控制台：仅填 App Key
DOUBAO_SPEECH_API_KEY=
# 与控制台一致的 uid，默认可与 API Key 相同
# DOUBAO_SPEECH_UID=
# 可选，覆盖默认接口地址
# DOUBAO_SPEECH_FLASH_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
# 旧版控制台（需 App Id + Access Token）时取消注释并填写：
# DOUBAO_SPEECH_LEGACY_APP_KEY=
# DOUBAO_SPEECH_LEGACY_ACCESS_KEY=

# --- OpenAI 兼容文本 API（润色/解析/补全/生图 prompt）：服务端兜底 ---
# 默认文本模型 Kimi K3。密钥只填在服务端，不要使用 NEXT_PUBLIC_* 暴露到浏览器。
KIMI_API_URL=https://api.kimi.com/coding/v1
KIMI_API_KEY=

# 未配置 NEXT_PUBLIC_LLM_* 时，按请求里的 x-api-url 选密钥：openclaudecode ≠ 4Router ≠ 豆包
# openclaudecode（同一域名，多 Key / 多分组时拆开写）
OPENCLAUDECODE_API_URL=https://www.openclaudecode.cn/v1
OPENCLAUDECODE_API_KEY_GPT=
OPENCLAUDECODE_API_KEY_CLAUDE=
# 若两端共用一把 Key，可只填：
# OPENCLAUDECODE_API_KEY=

# 4Router 等（与 openclaudecode 无关，勿混用）
GEMINI_API_URL=
GEMINI_API_KEY=
GEMINI_MODEL=

# 豆包 Ark（与上两者无关；生图可走 DOUBAO_* 或下方 GROK_*）
# DOUBAO_API_URL=
# DOUBAO_API_KEY=
# DOUBAO_IMAGE_MODEL=

# --- Grok Imagine：场景生图（/api/render phase=images）与梦境视频（/api/video）---
# 需网关提供与 xAI 一致的 REST 路径，见：
# https://docs.x.ai/developers/model-capabilities/images/generation
# https://docs.x.ai/developers/model-capabilities/video/generation
GROK_API_URL=https://www.openclaudecode.cn/v1
GROK_API_KEY=
# 场景生图（Grok 路径：/images/generations）；与首页/详情「生图模型」里的 Grok 选项对应
GROK_IMAGE_MODEL=grok-imagine-image-lite
GROK_VIDEO_MODEL=grok-imagine-video
# GPT Image 2：用于「生图模型」选 GPT Image 2；优先走 /images/generations（及参考图时 /images/edits），失败再试 /chat/completions
GPT_IMAGE2_API_URL=https://www.openclaudecode.cn/v1
GPT_IMAGE2_API_KEY=
# 若中转站文档要求其它路径（默认 videos/generations）
# GROK_VIDEO_GENERATIONS_PATH=videos/generations
# GROK_VIDEO_POLL_INTERVAL_MS=5000
# GROK_VIDEO_POLL_TIMEOUT_MS=900000
# 生图：场景之间间隔（毫秒），减轻「No available accounts」类限流
# GROK_IMAGE_SCENE_GAP_MS=2800
# GROK_IMAGE_RATE_LIMIT_RETRIES=6
# GROK_IMAGE_RATE_LIMIT_BASE_MS=2200

# --- 单卡本地 MiniMax H3（场景首帧 + 首帧视频，无外部生成 API）---
# 指向本机 ComfyUI 或已建立的 SSH 端口转发。ComfyUI 无需密钥。
# COMFYUI_LOCAL_URL=http://127.0.0.1:8190
# COMFYUI_H3_IMAGE_MODEL=minimax_h3_image_pruned_int8_convrot.safetensors
# COMFYUI_H3_VIDEO_MODEL=MiniMax-H3-FL2VA-Q8_0.gguf
# COMFYUI_H3_TEXT_ENCODER=qwen3vl_32b_minimax_h3-Q4_K_M.gguf
# COMFYUI_H3_IMAGE_VAE=minimax_h3_image_vae_fp16.safetensors
# COMFYUI_H3_VIDEO_VAE=minimax_h3_video_vae_fp16.safetensors
# COMFYUI_H3_AUDIO_VAE=minimax_h3_audio_vae_fp32.safetensors
# COMFYUI_H3_IMAGE_STEPS=6
# COMFYUI_H3_VIDEO_STEPS=25
# 合成界面的「草稿」档自动使用最多 12 步；「精细」档沿用上面的 25 步。
# COMFYUI_H3_IMAGE_TIMEOUT_MS=900000
# H3 单镜头实际可能超过 15 分钟，沿用 GROK_VIDEO_* 的轮询配置。
# GROK_VIDEO_POLL_INTERVAL_MS=5000
# GROK_VIDEO_POLL_TIMEOUT_MS=1800000

# --- 即梦同源视频：火山方舟 Seedance（推荐新接口，旧即梦 3.0 正在下线）---
# 官方文档: https://docs.volcengine.com/docs/ark/create-video-generation-task-api
# 使用方舟 API Key；也可用 JIMENG_API_URL 指向兼容网关。
# JIMENG_API_KEY=
# 也可复用已有方舟 Key：ARK_API_KEY=
# JIMENG_API_URL=https://ark.cn-beijing.volces.com/api/v3
# 默认使用广泛支持的 Seedance 1.0 Pro；账号有权限时可换成 2.x / 2.5 模型 ID。
# JIMENG_VIDEO_MODEL=doubao-seedance-1-0-pro-250528
# JIMENG_VIDEO_WATERMARK=false
# 可选：查询任务时返回尾帧 URL，供后续首尾帧连续镜头使用
# JIMENG_RETURN_LAST_FRAME=true

# --- 可选：成片旁白（不填不影响离线分镜样片）---
# OPENAI_TTS_API_URL=
# OPENAI_TTS_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=alloy
# VOLCENGINE_TTS_APP_ID=
# VOLCENGINE_TTS_ACCESS_TOKEN=
# VOLCENGINE_TTS_CLUSTER=volcano_tts
# VOLCENGINE_TTS_VOICE=zh_female_qingxin
# VOLCENGINE_TTS_SPEED=0.92
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=
# AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoNeural

# --- Browser / model picker (`src/app/page.tsx`, NEXT_PUBLIC_* is exposed to the client) ---
NEXT_PUBLIC_LLM_OPENCLAUDECODE_URL=https://www.openclaudecode.cn/v1
NEXT_PUBLIC_LLM_OPENCLAUDECODE_KEY_GPT=
NEXT_PUBLIC_LLM_OPENCLAUDECODE_KEY_CLAUDE=

NEXT_PUBLIC_LLM_4ROUTER_URL=https://4Router.net/v1
NEXT_PUBLIC_LLM_4ROUTER_KEY=

NEXT_PUBLIC_LLM_DOUBAO_URL=https://ark.cn-beijing.volces.com/api/v3
NEXT_PUBLIC_LLM_DOUBAO_KEY=
